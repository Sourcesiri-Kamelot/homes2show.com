# Homes2Show Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials

# === FIREBASE CONFIGURATION ===
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# === AI SERVICES ===
REACT_APP_OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_ORGANIZATION_ID=org-your_org_id_here

# === PAYMENT PROCESSING ===
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# === AWS SERVICES ===
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=homes2show-assets

# === EXTERNAL APIs ===
GOOGLE_MAPS_API_KEY=your_google_maps_key
ZILLOW_API_KEY=your_zillow_api_key
MLS_API_KEY=your_mls_api_key

# === APPLICATION SETTINGS ===
REACT_APP_ENVIRONMENT=development
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_DOMAIN=homes2show.com

# === ANALYTICS ===
REACT_APP_GOOGLE_ANALYTICS_ID=GA-your_tracking_id
REACT_APP_MIXPANEL_TOKEN=your_mixpanel_token

# === EMAIL SERVICES ===
SENDGRID_API_KEY=SG.your_sendgrid_key
MAILGUN_API_KEY=your_mailgun_key
MAILGUN_DOMAIN=mg.homes2show.com

# === SECURITY ===
JWT_SECRET=your_super_secure_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key

# === DEVELOPMENT ===
PORT=3000
HTTPS=false
BROWSER=none
FAST_REFRESH=true
